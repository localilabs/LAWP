{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/localilabs/lawp/main/schema/lawp.schema.json",
  "title": "LAWP document",
  "description": "Locali AI Web Protocol 0.4: a website's pages and actions for AI agents. Unknown fields are allowed for forward compatibility.",
  "type": "object",
  "required": [
    "domain",
    "name",
    "pages",
    "actions"
  ],
  "properties": {
    "lawp_version": {
      "type": "string",
      "pattern": "^0\\.[1-9][0-9]*(\\.[0-9]+)?$"
    },
    "domain": {
      "type": "string",
      "pattern": "^(?!https?://)[a-z0-9.-]+\\.[a-z]{2,}$",
      "description": "Without protocol, e.g. nike.com"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "language": {
      "$ref": "#/$defs/language"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ttl": {
      "type": "integer",
      "minimum": 300,
      "maximum": 604800
    },
    "pages": {
      "$ref": "#/$defs/pages"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "business": {
      "$ref": "#/$defs/business"
    },
    "accounts": {
      "$ref": "#/$defs/accounts"
    },
    "translations": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/language"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "pages": {
            "$ref": "#/$defs/pages"
          },
          "actions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "intent": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "more_pages": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/https_url"
      }
    }
  },
  "$defs": {
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-4]):[0-5][0-9]$"
    },
    "pages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^/"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "title",
          "content"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "maxLength": 5000
          }
        }
      }
    },
    "field": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "date",
            "time",
            "datetime",
            "email",
            "phone",
            "url",
            "enum"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "example": {}
      },
      "if": {
        "properties": {
          "type": {
            "const": "enum"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "options"
        ]
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "intent",
        "input"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "intent": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "input": {
          "type": "object",
          "required": [
            "type",
            "required"
          ],
          "properties": {
            "type": {
              "enum": [
                "text",
                "number",
                "none",
                "object"
              ]
            },
            "required": {
              "type": "boolean"
            },
            "fields": {
              "$ref": "#/$defs/fields"
            }
          },
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "then": {
            "required": [
              "fields"
            ]
          }
        },
        "endpoint": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "$ref": "#/$defs/https_url"
            },
            "method": {
              "enum": [
                "POST",
                "GET"
              ]
            }
          }
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "output": {
          "type": "object",
          "required": [
            "fields"
          ],
          "properties": {
            "fields": {
              "$ref": "#/$defs/fields"
            }
          }
        },
        "modes": {
          "type": "array",
          "items": {
            "enum": [
              "execute",
              "quote"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "safety": {
          "type": "object",
          "properties": {
            "requires_confirmation": {
              "type": "boolean"
            },
            "costs_money": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "required": [
                    "amount",
                    "currency"
                  ],
                  "properties": {
                    "amount": {
                      "type": "number",
                      "minimum": 0
                    },
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    }
                  }
                }
              ]
            },
            "reversible": {
              "type": "boolean"
            },
            "destructive": {
              "type": "boolean"
            }
          }
        },
        "account": {
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "A standard action type (v0.5): book_table, book_appointment, check_availability, request_quote, contact, order, search, subscribe"
        }
      }
    },
    "business": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "telephone": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "price_range": {
          "type": "string",
          "maxLength": 40
        },
        "address": {
          "type": "object",
          "properties": {
            "street": {
              "type": "string"
            },
            "postcode": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        },
        "geo": {
          "type": "object",
          "required": [
            "lat",
            "lon"
          ],
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "opening_hours": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "days",
              "opens",
              "closes"
            ],
            "properties": {
              "days": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "Mo",
                    "Tu",
                    "We",
                    "Th",
                    "Fr",
                    "Sa",
                    "Su"
                  ]
                },
                "uniqueItems": true
              },
              "opens": {
                "$ref": "#/$defs/time"
              },
              "closes": {
                "$ref": "#/$defs/time"
              }
            }
          }
        },
        "closed_on_public_holidays": {
          "type": "boolean"
        },
        "offers": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "price": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "category": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "action": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "accounts": {
      "type": "object",
      "required": [
        "type",
        "authorization_url",
        "token_url"
      ],
      "properties": {
        "type": {
          "const": "oauth2"
        },
        "authorization_url": {
          "$ref": "#/$defs/https_url"
        },
        "token_url": {
          "$ref": "#/$defs/https_url"
        },
        "registration_url": {
          "$ref": "#/$defs/https_url"
        },
        "scopes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
